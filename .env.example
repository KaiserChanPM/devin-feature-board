# Copy to .env and adjust. Real environment variables take precedence over this file.

# Port the backend API listens on. The frontend dev proxy forwards /api here.
PORT=3001

# Passcode that unlocks admin mode (used from M4).
ADMIN_PASSCODE=change-me

# Optional: SQLite file path, relative to /backend. Defaults to data/feature-board.db.
# DATABASE_PATH=data/feature-board.db
